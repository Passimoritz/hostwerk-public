        },
        "shortcuts": {
          "type": "array",
          "maxItems": 20,
          "description": "Keyboard shortcuts. Hostwerk registers them as ext:<extension id>:<id>; the user can change or switch them off (Settings → General → Shortcuts). They never take over one of Hostwerk's own shortcuts without the user's consent.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "keys"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,30}$"
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "keys": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9+,.;\\-/[\\]'`=]{1,40}$",
                "description": "One combination such as \"ctrl+alt+p\" – with ctrl or alt (F keys may stand alone). Copy/paste/undo and similar are reserved."
              },
              "action": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,30}$",
                "description": "What it does: the id of a page tab (opens it), of contributes.actions (runs it) or of contributes.new. Without it, the shortcut opens the page."
              }
            }
          }
        },
        "themes": {
          "type": "array",
          "maxItems": 6,
          "description": "SDK 2.9: colour themes. Only these CSS variables (colours as #rrggbb), checked for WCAG 2.2 AA contrast. Accent colours are derived from \"accent\".",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,30}$"
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "description": {
                "$ref": "#/definitions/text"
              },
              "tokens": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "dark": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "--bg": {
                        "type": "string"
                      },
                      "--bg-2": {
                        "type": "string"
                      },
                      "--surface": {
                        "type": "string"
                      },
                      "--surface-2": {
                        "type": "string"
                      },
                      "--surface-3": {
                        "type": "string"
                      },
                      "--line": {
                        "type": "string"
                      },
                      "--line-2": {
                        "type": "string"
                      },
                      "--text": {
                        "type": "string"
                      },
                      "--text-2": {
                        "type": "string"
                      },
                      "--muted": {
                        "type": "string"
                      },
                      "--ok": {
                        "type": "string"
                      },
                      "--ok-text": {
                        "type": "string"
                      },
                      "--warn": {
                        "type": "string"
                      },
                      "--warn-text": {
                        "type": "string"
                      },
                      "--err": {
                        "type": "string"
                      },
                      "--err-text": {
                        "type": "string"
                      },
                      "--info": {
                        "type": "string"
                      },
                      "--console-bg": {
                        "type": "string"
                      },
                      "--input-bg": {
                        "type": "string"
                      },
                      "--ok-soft": {
                        "type": "string"
                      },
                      "--warn-soft": {
                        "type": "string"
                      },
                      "--err-soft": {
                        "type": "string"
                      },
                      "--info-soft": {
                        "type": "string"
                      },
                      "--shadow": {
                        "type": "string"
                      },
                      "--shadow-lg": {
                        "type": "string"
                      }
                    }
                  },
                  "light": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "--bg": {
                        "type": "string"
                      },
                      "--bg-2": {
                        "type": "string"
                      },
                      "--surface": {
                        "type": "string"
                      },
                      "--surface-2": {
                        "type": "string"
                      },
                      "--surface-3": {
                        "type": "string"
                      },
                      "--line": {
                        "type": "string"
                      },
                      "--line-2": {
                        "type": "string"
                      },
                      "--text": {
                        "type": "string"
                      },
                      "--text-2": {
                        "type": "string"
                      },
                      "--muted": {
                        "type": "string"
                      },
                      "--ok": {
                        "type": "string"
                      },
                      "--ok-text": {
                        "type": "string"
                      },
                      "--warn": {
                        "type": "string"
                      },
                      "--warn-text": {
                        "type": "string"
                      },
                      "--err": {
                        "type": "string"
                      },
                      "--err-text": {
                        "type": "string"
                      },
                      "--info": {
                        "type": "string"
                      },
                      "--console-bg": {
                        "type": "string"
                      },
                      "--input-bg": {
                        "type": "string"
                      },
                      "--ok-soft": {
                        "type": "string"
                      },
                      "--warn-soft": {
                        "type": "string"
                      },
                      "--err-soft": {
                        "type": "string"
                      },
                      "--info-soft": {
                        "type": "string"
                      },
                      "--shadow": {
                        "type": "string"
                      },
                      "--shadow-lg": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "accent": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "accents": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              },
              "fonts": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "family",
                    "file"
                  ],
                  "properties": {
                    "family": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]{1,39}$"
                    },
                    "file": {
                      "type": "string",
                      "pattern": ".(woff2|woff|ttf|otf)$"
                    },
                    "weight": {
                      "type": "string",
                      "pattern": "^d{3}( d{3})?$"
                    },
                    "style": {
                      "enum": [
                        "normal",
                        "italic"
                      ]
                    }
                  }
                }
              },
              "font": {
                "type": "string",
                "description": "Family of one of \"fonts\"."
              },
              "radius": {
                "type": "number",
                "minimum": 0,
                "maximum": 2,
                "description": "Factor for all radii – 1 is Hostwerk’s own."
              },
              "density": {
                "enum": [
                  "compact",
                  "normal",
                  "comfortable"
                ]
              }
            }
          }
        },
        "overrides": {
          "type": "array",
          "maxItems": 10,
          "description": "SDK 2.9: replace or extend named places of Hostwerk’s interface. Needs the permission \"override:ui\"; active after the user agrees (official packages: right away), can be switched off with one click.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "slot",
              "mode",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,30}$"
              },
              "slot": {
                "enum": [
                  "dashboard.hero",
                  "web.empty",
                  "dbs.empty",
                  "minecraft.empty"
                ]
              },
              "mode": {
                "enum": [
                  "replace",
                  "before",
                  "after"
                ]
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "description": {
                "$ref": "#/definitions/text"
              },
              "file": {
                "type": "string",
                "pattern": ".html?$"
              },
              "preview": {
                "type": "string",
                "pattern": ".(png|webp|jpe?g|svg)$"
              },
              "height": {
                "type": "number",
                "minimum": 32,
                "maximum": 480
              },
              "order": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "extends": {
          "type": "array",
          "maxItems": 10,
          "description": "SDK 2.9: add to other extensions – only what their author allows in \"allowExtensions\". Needs the permission \"extend:extensions\".",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
              },
              "version": {
                "type": "string"
              },
              "tabs": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "file"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]{1,30}$"
                    },
                    "title": {
                      "$ref": "#/definitions/text"
                    },
                    "file": {
                      "type": "string",
                      "pattern": ".html?$"
                    },
                    "icon": {
                      "type": "string"
                    }
                  }
                }
              },
              "actions": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9-]{1,30}$"
                    },
                    "title": {
                      "$ref": "#/definitions/text"
                    },
                    "icon": {
                      "type": "string"
                    }
                  }
                }
              },
              "settings": {
                "const": true
              },
              "locales": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "de": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                }
              },
              "page": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "pattern": ".html?$"
                  }
                }
              }
            }
          }
        },
        "sections": {
          "type": "array",
          "maxItems": 8,
          "description": "Since SDK 3.2: sections inside Hostwerk detail views instead of own tabs (Minecraft server overview/players, folder in Files, web server). Hostwerk shows two per extension and place.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "on",
              "file"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,30}$"
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "icon": {
                "enum": [
                  "puzzle",
                  "users",
                  "monitor",
                  "gauge",
                  "activity",
                  "chart",
                  "bar-chart",
                  "bell",
                  "book",
                  "bot",
                  "box",
                  "calendar",
                  "camera",
                  "clock",
                  "cloud",
                  "code",
                  "coffee",
                  "cpu",
                  "database",
                  "download",
                  "file",
                  "flag",
                  "gamepad",
                  "gift",
                  "globe",
                  "heart",
                  "home",
                  "image",
                  "inbox",
                  "key",
                  "dashboard",
                  "grid",
                  "leaf",
                  "line-chart",
                  "list",
                  "lock",
                  "mail",
                  "map",
                  "message",
                  "music",
                  "network",
                  "news",
                  "package",
                  "pie-chart",
                  "radio",
                  "rocket",
                  "server",
                  "settings",
                  "shield",
                  "cart",
                  "sparkles",
                  "star",
                  "sun",
                  "swords",
                  "table",
                  "tag",
                  "terminal",
                  "timer",
                  "trophy",
                  "tv",
                  "wand",
                  "wifi",
                  "wrench",
                  "zap",
                  "smartphone",
                  "cloud-upload",
                  "folder-up",
                  "file-search",
                  "router"
                ],
                "description": "Line icon for the sidebar (same style as Hostwerk's own areas)."
              },
              "on": {
                "enum": [
                  "mc.overview",
                  "mc.players",
                  "files.folder",
                  "web.site"
                ],
                "description": "Where the section appears – Hostwerk.context tells the page the place and its target ({ kind, id } or { kind: \"folder\", root, path })."
              },
              "file": {
                "type": "string",
                "pattern": "^[^/\\\\.][^\\\\]*\\.html$"
              },
              "height": {
                "type": "number",
                "minimum": 48,
                "maximum": 900,
                "description": "Highest height in px – the frame grows with its content up to that (default 900)."
              },
              "role": {
                "enum": [
                  "motd"
                ],
                "description": "SDK 3.2: the section takes over a card Hostwerk shows there itself. mc.overview + \"motd\" = shows and edits how players see the server (MOTD and icon) – Hostwerk's card “How players see your server” then steps back."
              }
            }
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "maxItems": 10,
      "description": "UI language packs this extension maintains (Hostwerk itself ships German and English). File format like Hostwerk's en.json: { \"texts\": { \"<German text>\": \"<translation>\" }, \"patterns\": [[\"text with {}\", \"translation with {}\"]] }. Missing texts fall back to English.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$",
            "description": "Language code, e.g. \"fr\" or \"pt-BR\" (not \"de\"/\"en\")"
          },
          "name": {
            "type": "string",
            "maxLength": 40,
            "description": "Name in the language itself, e.g. \"Français\""
          },
          "file": {
            "type": "string",
            "pattern": "^[^/\\\\.][^\\\\]*\\.json$"
          }
        }
      }
    },
    "settingsTab": {
      "enum": [
        "general",
        "start",
        "notifications",
        "advanced",
        "extensions"
      ],
      "description": "SDK 2.8: in which tab of Hostwerk's settings the form from \"settings\" appears (default: extensions)."
    },
    "synergies": {
      "type": "array",
      "description": "SDK 2.8: other extensions this one works well with – shown under Extensions → Ideas & synergies.",
      "items": {
        "type": "object",
        "required": [
          "with",
          "title"
        ],
        "properties": {
          "with": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
          },
          "title": {
            "$ref": "#/definitions/text"
          },
          "text": {
            "$ref": "#/definitions/text"
          }
        }
      }
    },
    "provides": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][\\w-]{1,40}$"
      },
      "description": "SDK 2.8: services this extension offers to others (host.provide). Matching \"uses\" of other extensions are suggested as synergies."
    },
    "uses": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][\\w-]{1,40}$"
      },
      "description": "SDK 2.8: services of other extensions this one uses (host.use)."
    },
    "publicView": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "description": "HTML file of the public view (its folder is served at /v/<id>/)."
        },
        "title": {
          "description": "Name shown in the extension details (text or { de, en })."
        }
      },
      "description": "SDK 2.10: a public view without login at /v/<id>/ (e.g. an OBS overlay). Sandboxed, scripts allowed, may only fetch /api/x/<id>/pub/… of its own server part. Needs the permission \"share:view\"."
    },
    "shareStorage": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(\\*|[a-z0-9][a-z0-9-]{1,39})$"
      },
      "description": "SDK 2.10: extensions that may read this extension's storage (read only, e.g. [\"claude\"] or [\"*\"]) – host.storage.of(id) / host.storageOf(id)."
    },
    "allowExtensions": {
      "type": "object",
      "description": "SDK 2.9: which extensions may add what to this one: { \"other-id\": [\"tabs\", \"actions\", \"settings\", \"locales\", \"page\"], \"*\": [\"tabs\", \"actions\", \"settings\"] }. Remove an entry in a new version to take it back.",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "tabs",
            "actions",
            "settings",
            "locales",
            "page"
          ]
        }
      }
    }
  }
}
