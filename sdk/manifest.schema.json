{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/manifest.schema.json",
  "title": "Hostwerk extension manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version"
  ],
  "definitions": {
    "text": {
      "description": "Plain text or one text per language (German and English are expected in the catalog).",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "de": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          },
          "required": [
            "de",
            "en"
          ],
          "additionalProperties": false
        }
      ]
    },
    "entry": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "title": {
          "$ref": "#/definitions/text"
        },
        "file": {
          "type": "string",
          "pattern": "^[^/\\\\.][^\\\\]*\\.html$"
        },
        "icon": {
          "enum": [
            "puzzle",
            "users",
            "monitor",
            "gauge",
            "activity",
            "chart",
            "bar-chart",
            "bell",
            "book",
            "bot",
            "box",
            "calendar",
            "camera",
            "clock",
            "cloud",
            "code",
            "coffee",
            "cpu",
            "database",
            "download",
            "file",
            "flag",
            "gamepad",
            "gift",
            "globe",
            "heart",
            "home",
            "image",
            "inbox",
            "key",
            "dashboard",
            "grid",
            "leaf",
            "line-chart",
            "list",
            "lock",
            "mail",
            "map",
            "message",
            "music",
            "network",
            "news",
            "package",
            "pie-chart",
            "radio",
            "rocket",
            "server",
            "settings",
            "shield",
            "cart",
            "sparkles",
            "star",
            "sun",
            "swords",
            "table",
            "tag",
            "terminal",
            "timer",
            "trophy",
            "tv",
            "wand",
            "wifi",
            "wrench",
            "zap",
            "smartphone",
            "cloud-upload",
            "folder-up",
            "file-search",
            "router"
          ],
          "description": "Line icon for the sidebar (same style as Hostwerk's own areas)."
        },
        "size": {
          "enum": [
            "third",
            "half",
            "full"
          ],
          "description": "Widget width on the dashboard."
        },
        "description": {
          "$ref": "#/definitions/text",
          "description": "One sentence under the page title (SDK 2.2)."
        },
        "tabs": {
          "type": "array",
          "maxItems": 8,
          "description": "Tabs drawn by Hostwerk above the page (SDK 2.2). The page gets Hostwerk.tab and Hostwerk.on(\"tab\").",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,30}$"
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "icon": {
                "enum": [
                  "puzzle",
                  "users",
                  "monitor",
                  "gauge",
                  "activity",
                  "chart",
                  "bar-chart",
                  "bell",
                  "book",
                  "bot",
                  "box",
                  "calendar",
                  "camera",
                  "clock",
                  "cloud",
                  "code",
                  "coffee",
                  "cpu",
                  "database",
                  "download",
                  "file",
                  "flag",
                  "gamepad",
                  "gift",
                  "globe",
                  "heart",
                  "home",
                  "image",
                  "inbox",
                  "key",
                  "dashboard",
                  "grid",
                  "leaf",
                  "line-chart",
                  "list",
                  "lock",
                  "mail",
                  "map",
                  "message",
                  "music",
                  "network",
                  "news",
                  "package",
                  "pie-chart",
                  "radio",
                  "rocket",
                  "server",
                  "settings",
                  "shield",
                  "cart",
                  "sparkles",
                  "star",
                  "sun",
                  "swords",
                  "table",
                  "tag",
                  "terminal",
                  "timer",
                  "trophy",
                  "tv",
                  "wand",
                  "wifi",
                  "wrench",
                  "zap",
                  "smartphone",
                  "cloud-upload",
                  "folder-up",
                  "file-search",
                  "router"
                ],
                "description": "Line icon for the sidebar (same style as Hostwerk's own areas)."
              }
            }
          }
        },
        "shortcuts": {
          "type": "array",
          "maxItems": 20,
          "description": "Keyboard shortcuts of this page, shown in Hostwerk's shortcut overview (F1 or ?) while the page is open.",
          "items": {
            "type": "object",
            "required": [
              "keys",
              "label"
            ],
            "properties": {
              "keys": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "maxLength": 12
                }
              },
              "label": {
                "$ref": "#/definitions/text"
              }
            }
          }
        },
        "nav": {
          "oneOf": [
            {
              "$ref": "#/definitions/nav"
            },
            {
              "const": false,
              "description": "SDK 3.2: no own sidebar entry – the extension lives in Hostwerk's areas (tabs, sections, tiles); the page stays reachable from Extensions → Open. People can still pin it in the sidebar editor. Older Hostwerk versions ignore it and keep the entry."
            }
          ]
        }
      }
    },
    "nav": {
      "type": "object",
      "description": "Where the page sits in the sidebar – like Hostwerk's own areas (SDK 2.8, own areas and \"after\" since Hostwerk 2.11). People can still drag it elsewhere or hide it.",
      "required": [
        "group"
      ],
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,30}$",
          "description": "server = under “Server”, develop = under “Develop”, system = at the bottom next to AI/System, or the id of an OWN area (needs groupTitle; it only shows while a page is in it). “extensions” (old) = Hostwerk places it by category."
        },
        "order": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Position inside the group (default 50)"
        },
        "groupTitle": {
          "type": "object",
          "description": "Title of an own area: { \"de\": …, \"en\": … }. Several extensions with the same group id share the area.",
          "required": [
            "de",
            "en"
          ],
          "properties": {
            "de": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          }
        },
        "after": {
          "type": "string",
          "pattern": "^(ext:)?[a-z0-9][a-z0-9-]{1,39}$",
          "description": "Show right after this sidebar entry, e.g. \"mc\", \"terminal\" or \"ext:api-tester\"."
        }
      }
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
    },
    "name": {
      "$ref": "#/definitions/text"
    },
    "description": {
      "$ref": "#/definitions/text"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[\\w.]+)?$"
    },
    "author": {
      "type": "string"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "Path to icon.svg/png in the package (square)."
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "hostwerk": {
      "description": "Hostwerk versions this extension runs on: a minimum like \">=3.0.0\" or (SDK 3.0) { \"min\": \"3.0.0\", \"max\": \"3.x\" }.",
      "oneOf": [
        {
          "type": "string",
          "pattern": "^>=\\s*\\d+\\.\\d+\\.\\d+$"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$",
              "description": "Lowest Hostwerk version, e.g. 3.0.0"
            },
            "max": {
              "type": "string",
              "pattern": "^\\d+(\\.(\\d+|x))?(\\.(\\d+|x))?$",
              "description": "Highest Hostwerk version (inclusive): 3.x, 3.4.x or 3.4.2"
            }
          }
        }
      ]
    },
    "sdkVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$",
      "description": "SDK 3.0: which SDK this extension was written for, e.g. \"3.0\". Every SDK 3.x runs extensions written for 3.0 up to its own minor version."
    },
    "experimental": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "SDK 3.0: opt-in to experimental APIs (may change in any version, not allowed in the catalog)."
    },
    "category": {
      "enum": [
        "games",
        "network",
        "security",
        "monitoring",
        "developer",
        "ai",
        "communication",
        "other"
      ],
      "description": "Category on the extension page (SDK 2.7)."
    },
    "banner": {
      "type": "string",
      "description": "Wide banner (SVG/PNG/WebP, about 16:5, e.g. 1280×400) for the detail view and catalog card (SDK 2.7). Animations must stop under prefers-reduced-motion."
    },
    "screenshots": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string"
      },
      "description": "Up to 6 screenshots in the package (e.g. docs/screenshot-1.png), shown in the detail view (SDK 2.7)."
    },
    "requires": {
      "type": "object",
      "description": "Other extensions this one needs, with a version range (SDK 2.7). Hostwerk installs them first and warns before removing one that others need.",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{1,39}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(\\*|(>=|\\^|~)?\\s*\\d+\\.\\d+\\.\\d+)$"
      }
    },
    "backend": {
      "type": "string",
      "pattern": "^[^/\\\\.][^\\\\]*\\.(c?js|mjs)$",
      "description": "Native server module (SDK 2.7): exports activate(host) and optionally deactivate(). Needs the native permission; only from the Hostwerk catalog or in developer mode."
    },
    "ui": {
      "type": "string",
      "pattern": "^[^/\\\\.][^\\\\]*\\.(c?js|mjs)$",
      "description": "Native interface module (SDK 2.7): an ES module exporting default { pages, slots }, built with sdk/build-native.js. Needs the native permission."
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "read:services",
          "read:web",
          "read:databases",
          "read:minecraft",
          "read:apps",
          "read:tasks",
          "read:mail",
          "read:system",
          "read:network",
          "read:live",
          "share:status",
          "control:services",
          "command:minecraft",
          "run:tasks",
          "change:minecraft",
          "change:databases",
          "change:mail",
          "read:knowledge",
          "change:knowledge",
          "connect:claude",
          "read:claude",
          "change:claude",
          "run:terminal",
          "read:profile",
          "read:games",
          "change:ports",
          "share:view",
          "override:ui",
          "extend:extensions",
          "native",
          "storage",
          "network",
          "read",
          "write"
        ]
      }
    },
    "network": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://[a-z0-9.-]+(:\\d+)?$"
      },
      "description": "Web origins the page may fetch (needs the network permission)."
    },
    "page": {
      "$ref": "#/definitions/entry"
    },
    "widget": {
      "$ref": "#/definitions/entry"
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "type",
          "label"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w-]{0,39}$"
          },
          "type": {
            "enum": [
              "text",
              "number",
              "switch",
              "select"
            ]
          },
          "label": {
            "$ref": "#/definitions/text"
          },
          "hint": {
            "$ref": "#/definitions/text"
          },
          "default": {},
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {},
                "label": {
                  "$ref": "#/definitions/text"
                }
              },
              "required": [
                "value",
                "label"
              ]
            }
          }
        }
      }
    },
    "command": {
      "type": "string",
      "description": "Optional own service (program) – see the developer guide."
    },
    "contributes": {
      "type": "object",
      "description": "Extend Hostwerk areas (SDK 2.2): own tabs on service pages and actions in right-click menus / quick search.",
      "properties": {
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "on",
              "file"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,30}$"
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "icon": {
                "enum": [
                  "puzzle",
                  "users",
                  "monitor",
                  "gauge",
                  "activity",
                  "chart",
