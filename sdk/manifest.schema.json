                  "enum": [
                    "palette",
                    "minecraft",
                    "web",
                    "db",
                    "app",
                    "game",
                    "file",
                    "folder"
                  ]
                }
              }
            }
          }
        },
        "new": {
          "type": "array",
          "description": "SDK 2.8: tiles in Hostwerk's “New” menu – they open the extension page with this action (Hostwerk.on('action')).",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,30}$"
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "description": {
                "$ref": "#/definitions/text"
              },
              "icon": {
                "enum": [
                  "puzzle",
                  "users",
                  "monitor",
                  "gauge",
                  "activity",
                  "chart",
