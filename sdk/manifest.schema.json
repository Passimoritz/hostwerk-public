                  "gift",
                  "globe",
                  "heart",
                  "home",
                  "image",
                  "inbox",
                  "key",
                  "dashboard",
                  "grid",
                  "leaf",
                  "line-chart",
                  "list",
                  "lock",
                  "mail",
                  "map",
                  "message",
                  "music",
                  "network",
                  "news",
                  "package",
                  "pie-chart",
                  "radio",
                  "rocket",
                  "server",
                  "settings",
                  "shield",
                  "cart",
                  "sparkles",
                  "star",
                  "sun",
                  "swords",
                  "table",
                  "tag",
                  "terminal",
                  "timer",
                  "trophy",
                  "tv",
                  "wand",
                  "wifi",
                  "wrench",
                  "zap",
                  "smartphone",
                  "cloud-upload",
                  "folder-up",
                  "file-search",
                  "router"
                ],
                "description": "Line icon for the sidebar (same style as Hostwerk's own areas)."
              },
              "on": {
                "enum": [
                  "minecraft",
                  "web",
                  "db",
                  "app",
                  "game",
                  "project",
                  "area:web",
                  "area:dbs",
                  "area:minecraft",
                  "area:projects",
                  "area:mail",
                  "area:system",
                  "area:live",
                  "area:ai",
                  "area:backups",
                  "area:tasks"
                ],
                "description": "Detail pages (minecraft, web, db, app, game) or – since SDK 2.8 – main areas (area:system, area:backups, area:ai …; area:tasks since SDK 3.2)"
              },
              "file": {
                "type": "string",
                "pattern": "^[^/\\\\.][^\\\\]*\\.html$"
              },
              "fallback": {
                "type": "boolean",
                "description": "Since SDK 3.2: only shown by Hostwerk versions without sections – from 3.2 on the section from contributes.sections appears instead."
              },
              "page": {
                "type": "boolean",
                "description": "Since SDK 3.2 (Hostwerk 3.0, later build): only with on: area:… and file = page.file – the whole extension page appears as a tab of that main area, its page.tabs as sub-navigation on the left; #/ext/<id> leads there. Older versions show file as a plain tab."
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "on"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]{1,30}$"
              },
              "title": {
                "$ref": "#/definitions/text"
              },
              "icon": {
                "enum": [
                  "puzzle",
                  "users",
                  "monitor",
                  "gauge",
