{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Passimoritz/hostwerk-public/main/sdk/setup.schema.json",
  "title": "Hostwerk project setup (.hostwerk/setup.json)",
  "description": "What a project needs – Hostwerk shows the plan (what exists, what would be created) and sets it up with one click. Commands under \"setup\" only run after confirmation; paths stay inside the project.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "Link to this schema (editors complete and check the file)." },
    "php": { "type": "string", "pattern": "^\\d+\\.\\d+$", "description": "PHP version, e.g. \"8.3\".", "examples": ["8.3", "8.2"] },
    "node": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$", "description": "Node.js version, e.g. \"20\".", "examples": ["22", "20"] },
    "web": {
      "type": "object",
      "description": "Address of the project at Hostwerk's web server.",
      "required": ["domain"],
      "additionalProperties": false,
      "properties": {
        "domain": { "type": "string", "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9-]{2,63}$", "description": "Local name, e.g. \"shop.localhost\" or \"shop.test\".", "examples": ["shop.localhost"] },
        "root": { "type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$)).*$", "default": ".", "description": "Web folder inside the project (no \"..\"), e.g. \"public\" for Laravel.", "examples": ["public", "."] }
      }
    },
    "databases": {
      "type": "array",
      "description": "Databases the project uses – Hostwerk creates missing ones on its own servers.",
      "items": {
        "type": "object",
        "required": ["engine", "name"],
        "additionalProperties": false,
        "properties": {
          "engine": { "enum": ["mariadb", "mysql", "postgres", "mongodb"] },
          "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$-]{0,63}$" }
        }
      }
    },
    "services": {
      "type": "array",
      "description": "Additional services: \"redis\" and \"mail\" (mail catcher).",
      "uniqueItems": true,
      "items": { "enum": ["redis", "mail"] }
    },
    "apps": {
      "type": "array",
      "description": "Programs that run alongside, e.g. the Vite dev server.",
      "items": {
        "type": "object",
        "required": ["command"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "maxLength": 60 },
          "command": { "type": "string", "minLength": 1, "maxLength": 300, "examples": ["npm run dev", "php artisan queue:work"] },
          "port": { "type": ["integer", "null"], "minimum": 1024, "maximum": 65535 }
        }
      }
    },
    "env": {
      "type": "object",
      "description": "Values for the project's .env.",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$" },
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "setup": {
      "type": "array",
      "description": "Commands in the project folder – only run after confirmation in the plan.",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 },
      "examples": [["composer install", "npm install", "php artisan migrate"]]
    }
  }
}
